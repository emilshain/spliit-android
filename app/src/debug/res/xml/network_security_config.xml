<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug only: plain http is allowed where a development Spliit instance actually lives, and
    nowhere else. Release builds carry no such file, so the platform default applies and every
    request must be https.

    10.0.2.2 is the host machine as the emulator sees it, which is where `tools/fake-spliit`
    listens. A real server on the LAN needs its address listed here too: Android's network
    security config matches hosts by name and by literal IP, and has no way to say "a subnet",
    so an address cannot be allowed by range. Add one domain entry per machine, for example:

        <domain includeSubdomains="false">192.168.1.10</domain>
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
