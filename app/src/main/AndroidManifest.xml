<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading whether a network is up; without it ConnectivityManager throws, not asks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Receipts are taken with the phone's camera app; the chooser has to see it. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Nothing here is backed up. A Spliit group ID is the group's only credential — whoever
         holds it can read and write the group — and this device is its only copy: it lives in
         the recent-groups store, beside the server address and any expense waiting in the
         outbox. Auto Backup would put all of that in Google's cloud and in a device-to-device
         transfer, so it is off, and a reinstall means adding the group again from its link. -->
    <application
        android:name=".SpliitApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spliit">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Spliit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A photo taken for a receipt is written into a file this app owns and handed to the
             camera through this provider. Declared here: without it every camera tap failed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
